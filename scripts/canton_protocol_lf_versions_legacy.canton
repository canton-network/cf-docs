import io.circe.syntax._
import com.digitalasset.canton.version.{EngineMode, ProtocolVersion}
import com.digitalasset.daml.lf.language.LanguageVersion
import com.digitalasset.daml.lf.transaction.NextGenContractStateMachine

// Canton release lines before 3.6 have no InterpretationConfig. Their participants accept the
// stable Daml-LF versions in commands, except that a protocol version whose engine mode has no
// contract keys rejects packages from the contract-keys LF version onward
// (Engine.checkAllowedDeps). Newest first, matching the 3.6+ probe.
sealed trait ProtocolVersionStatus {
  def protocolVersion: ProtocolVersion
  def isBeta: Boolean = this match {
    case ProtocolVersionStatus.Beta(_) => true
    case _ => false
  }
}

object ProtocolVersionStatus {
  implicit val ordering: Ordering[ProtocolVersionStatus] = Ordering.by(_.protocolVersion)
  final case class Beta(protocolVersion: ProtocolVersion) extends ProtocolVersionStatus
  final case class Stable(protocolVersion: ProtocolVersion) extends ProtocolVersionStatus
}

val contractKeysFrom = LanguageVersion.featureContractKeys.versionRange.min

val lfRows = (List.from(ProtocolVersion.stable).map[ProtocolVersionStatus](ProtocolVersionStatus.Stable) ++
  List.from(ProtocolVersion.beta).map[ProtocolVersionStatus](ProtocolVersionStatus.Beta)).sorted.reverse
  .map { status =>
    val suffix = if (status.isBeta) "*" else ""
    val withoutKeys = EngineMode.forProtocolVersion(status.protocolVersion) == NextGenContractStateMachine.Mode.NoKey
    s"${status.protocolVersion}$suffix" -> LanguageVersion.stableLfVersions
      .filter(version => !withoutKeys || version < contractKeysFrom)
      .sorted
      .reverse
      .map(_.pretty)
  }

println(io.circe.Json.obj("protocolVersionsToLfVersions" -> lfRows.asJson).spaces2)
