{% import "shared/reference_macros.md.j2" as ref %}
<div class="x2mdx-ref-page x2mdx-ref-page--operation{% if page.api_frontmatter %} x2mdx-ref-page--manual-api{% endif %}"></div>

{% if page.api_frontmatter %}
{{ ref.header(None, page.title, page.summary, None, None, page.badges, [], render_title=False, render_summary=True) }}
{{ ref.mintlify_operation_examples(page.examples) }}
{{ ref.manual_api_operation_sections(page) }}{% if page.history_events %}
{{ ref.history_section(page.history_events) }}{% endif %}
{% else %}
<div className="x2mdx-ref-operation-shell">
<div className="x2mdx-ref-operation-main">

{{ ref.breadcrumbs(page.breadcrumbs) }}
{{ ref.header(page.eyebrow, page.title, page.summary, None, None, page.badges, [], render_title=True, render_summary=False) }}
{{ ref.operation_bar(page) }}
{% if page.overview_markdown %}
{{ page.overview_markdown }}
{% endif %}
{{ ref.operation_sections(page, include_examples=False, use_api_components=page.api_frontmatter is not none) }}{% if page.history_events %}
{{ ref.history_section(page.history_events) }}{% endif %}

</div>
{{ ref.operation_right_rail(page) }}
</div>
{% endif %}
